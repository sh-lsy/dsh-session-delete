{
  "name": "@sh-lsy/dsh-session-delete",
  "version": "0.2.0",
  "description": "Session cleanup and in-place conversation rewind for DeepSeek Harness: delete sessions (single/batch) with artifact and attachment GC, and rewind to any earlier user message in the same session (opencode/Claude Code-style) with conflict-aware file restore, a mode chooser, and a /rewind candidate picker",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "undo-host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "cleanup",
    "undo"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}